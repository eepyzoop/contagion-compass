# Any Postgres 16 server -- a native local install, or a hosted instance
# (Neon, Supabase, etc). Hosted providers need ?sslmode=require appended.
DATABASE_URL=postgresql://user:password@localhost:5432/contagion_compass

# Legacy: RDS Postgres, used while the AWS deployment is still live.
# Leave blank once AWS is decommissioned.
DATABASE_URL_AWS=

# Phase 2b: primary local LLM (falls back to Gemini automatically if unreachable)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Fallback LLM -- free tier key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Phase 5: S3 bucket for report storage. Leave blank to skip upload (local-only).
# AWS credentials come from ~/.aws (aws configure), not from this file.
S3_BUCKET=

# Phase 4: Slack incoming webhook URL. Leave blank to skip notifications --
# only posts when the agent flags something. https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Phase 7: comma-separated origins allowed to call src/api.py cross-origin
# (the deployed dashboard's URL). Leave blank to disable CORS entirely.
CORS_ORIGINS=
