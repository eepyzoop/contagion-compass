DATABASE_URL=postgresql+psycopg2://contagion:contagion@localhost:5432/contagion_compass

# Phase 5: RDS Postgres, used by scheduled cloud execution instead of local docker-compose.
# Leave blank for local dev.
DATABASE_URL_AWS=

# Phase 2b: primary local LLM (falls back to Gemini automatically if unreachable)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Fallback LLM -- free tier key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Phase 5: S3 bucket for report storage. Leave blank to skip upload (local-only).
# AWS credentials come from ~/.aws (aws configure), not from this file.
S3_BUCKET=

# Phase 4: Slack incoming webhook URL. Leave blank to skip notifications --
# only posts when the agent flags something. https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
